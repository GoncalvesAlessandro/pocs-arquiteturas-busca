        "import requests\n",
        "from bs4 import BeautifulSoup\n",
        "import json\n",
        "import os\n",
        "from google.colab import drive\n",
        "\n",
        "drive.mount('/content/drive')\n",
        "caminho_pasta = '/content/drive/MyDrive/TCC_Base_Dados_POC'\n",
        "\n",
        "if not os.path.exists(caminho_pasta):\n",
        "    os.makedirs(caminho_pasta)\n",
        "\n",
        "print(\"A descarregar a Constituição Federal do site oficial do Planalto...\")\n",
        "\n",
        "url_cf = 'https://www.planalto.gov.br/ccivil_03/constituicao/constituicao.htm'\n",
        "headers = {'User-Agent': 'Mozilla/5.0'}\n",
        "\n",
        "resposta = requests.get(url_cf, headers=headers)\n",
        "resposta.encoding = resposta.apparent_encoding\n",
        "\n",
        "soup = BeautifulSoup(resposta.text, 'html.parser')\n",
        "\n",
        "paragrafos = soup.find_all(['p', 'div'])\n",
        "\n",
        "artigos_extraidos = []\n",
        "contador_id = 1\n",
        "\n",
        "print(\"A processar e limpar os textos da Constituição...\")\n",
        "\n",
        "for p in paragrafos:\n",
        "    texto_limpo = p.get_text(strip=True)\n",
        "\n",
        "    if len(texto_limpo) > 30 and not texto_limpo.lower().startswith(('vide', 'redação dada', 'incluído pela')):\n",
        "        artigos_extraidos.append({\n",
        "            \"id\": f\"cf_art_{contador_id}\",\n",
        "            \"texto\": texto_limpo\n",
        "        })\n",
        "        contador_id += 1\n",
        "\n",
        "caminho_ficheiro = os.path.join(caminho_pasta, 'dataset_constituicao.json')\n",
        "\n",
        "with open(caminho_ficheiro, 'w', encoding='utf-8') as f:\n",
        "    json.dump(artigos_extraidos, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "print(\"------\")\n",
        "print(f\"Foram extraídos {len(artigos_extraidos)} blocos de texto da Constituição.\")\n",
        "print(f\"O seu dataset foi guardado em: {caminho_ficheiro}\")"
      ]
    },
  ]
